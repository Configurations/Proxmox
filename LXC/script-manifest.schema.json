{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agflow.docker/schemas/script-manifest.json",
  "title": "Script Manifest",
  "description": "Manifest JSON pour les scripts d'infrastructure agflow. Définit les arguments attendus, la liste de commandes à exécuter via SSH, et les tags de catégorisation.",
  "type": "object",
  "required": ["args", "commands"],
  "additionalProperties": false,
  "properties": {
    "args": {
      "type": "array",
      "description": "Liste des arguments à collecter avant exécution",
      "items": {
        "type": "object",
        "required": ["arg", "type", "required"],
        "additionalProperties": false,
        "properties": {
          "arg": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Nom de la variable (UPPER_SNAKE_CASE). Sera substituée dans la commande via {ARG}"
          },
          "label_fr": {
            "type": "string",
            "description": "Label affiché dans l'UI (français)"
          },
          "label_en": {
            "type": "string",
            "description": "Label affiché dans l'UI (anglais)"
          },
          "description_fr": {
            "type": "string",
            "description": "Description / aide contextuelle (français)"
          },
          "description_en": {
            "type": "string",
            "description": "Description / aide contextuelle (anglais)"
          },
          "type": {
            "type": "string",
            "enum": ["string", "integer", "boolean", "select"],
            "description": "Type de valeur attendue"
          },
          "required": {
            "type": "boolean",
            "description": "Si true, l'argument doit être renseigné avant exécution"
          },
          "default": {
            "type": ["string", "integer", "boolean"],
            "description": "Valeur par défaut si non renseigné"
          },
          "options": {
            "type": "array",
            "description": "Choix littéraux value/label (uniquement si type=select). Combinables avec 'option_script' pour ajouter des valeurs dynamiques.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["value", "label"],
              "additionalProperties": false,
              "properties": {
                "value": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "option_script": {
            "type": "string",
            "minLength": 1,
            "description": "Commande shell exécutée sur l'hôte cible (uniquement si type=select). Sa stdout (1 valeur par ligne, lignes vides ignorées) fournit des valeurs supplémentaires. Au runtime : liste finale = options (ordre du manifest préservé) ++ sortie du script triée alphabétiquement, le tout dédupliqué (1ère occurrence gardée). Si 'default' est défini, il est placé en tête (déplacé ou injecté)."
          },
          "pattern": {
            "type": "string",
            "description": "Regex de validation (si type=string)"
          },
          "min": {
            "type": "integer",
            "description": "Valeur minimale (si type=integer)"
          },
          "max": {
            "type": "integer",
            "description": "Valeur maximale (si type=integer)"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "select" } }, "required": ["type"] },
            "then": { "anyOf": [ { "required": ["options"] }, { "required": ["option_script"] } ] }
          },
          {
            "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
            "then": { "not": { "anyOf": [ { "required": ["min"] }, { "required": ["max"] }, { "required": ["options"] }, { "required": ["option_script"] } ] } }
          },
          {
            "if": { "properties": { "type": { "const": "integer" } }, "required": ["type"] },
            "then": { "not": { "anyOf": [ { "required": ["pattern"] }, { "required": ["options"] }, { "required": ["option_script"] } ] } }
          },
          {
            "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
            "then": { "not": { "anyOf": [ { "required": ["pattern"] }, { "required": ["min"] }, { "required": ["max"] }, { "required": ["options"] }, { "required": ["option_script"] } ] } }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "description": "Liste ordonnée de commandes shell à exécuter via SSH dans le même contexte. Les placeholders {ARG} sont remplacés par les valeurs saisies.",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "description": "Tags de catégorisation utilisés par l'UI pour filtrer/grouper les scripts (ex: 'create_lxc', 'create_vm', 'docker', 'swarm', 'add_node').",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9_]+$"
      },
      "uniqueItems": true
    }
  }
}
